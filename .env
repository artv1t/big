# Wallet - NEED NEW CREDENTIALS (previous one compromised on GitHub)
# PRIVATE_KEY=your_new_wallet_private_key_here

# Connection (Triton RPC - reliable for WebSocket subscriptions)
HELIUS_RPC_URL=https://rpc.ankr.com/solana
HELIUS_WS_URL=wss://rpc.ankr.com/solana/ws
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
PRE_LOAD_EXISTING_MARKETS=true
CACHE_NEW_MARKETS=true
TRANSACTION_EXECUTOR=warp
CUSTOM_FEE=0.01

# Buy
AUTO_BUY_DELAY=1000
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.0001
MAX_BUY_RETRIES=3
BUY_SLIPPAGE=10

# Sell
AUTO_SELL=false
AUTO_SELL_DELAY=5000
MAX_SELL_RETRIES=3
TAKE_PROFIT=20
STOP_LOSS=10
PRICE_CHECK_INTERVAL=1000
PRICE_CHECK_DURATION=10000
SELL_SLIPPAGE=10

# Filters
FILTER_CHECK_INTERVAL=1000
FILTER_CHECK_DURATION=10000
CONSECUTIVE_FILTER_MATCHES=2
CHECK_IF_MUTABLE=true
CHECK_IF_SOCIALS=false
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=true
CHECK_IF_BURNED=true
MIN_POOL_SIZE=1
MAX_POOL_SIZE=100
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=300000
